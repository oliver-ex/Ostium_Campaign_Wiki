filters:
  and:
    - file.inFolder("Session Logs")
    - or:
        - type == "session-log"
        - type == "session-prep"
properties:
  table:
    displayName: Table
  status:
    displayName: Status
  file.name:
    displayName: Name
  session:
    displayName: Session
  date:
    displayName: Date
  pcs-present:
    displayName: PCs Present
  locations:
    displayName: Locations
  npcs:
    displayName: NPCs
  factions:
    displayName: Factions
views:
  - type: table
    name: Session Logs
    order:
      - table
      - session
      - status
      - file.name
      - date
      - pcs-present
      - locations
      - npcs
      - factions
  - type: table
    name: Steven's Table
    filters:
      and:
        - file.inFolder("Session Logs/Steven's Table")
    order:
      - session
      - file.name
      - status
      - date
      - pcs-present
  - type: table
    name: Oliver's Table
    filters:
      and:
        - file.inFolder("Session Logs/Oliver's Table")
    order:
      - session
      - file.name
      - status
      - date
      - pcs-present
