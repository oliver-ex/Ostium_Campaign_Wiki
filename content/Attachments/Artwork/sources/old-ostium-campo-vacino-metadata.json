        "Artist": {
          "value": "<bdi><a rel=\"mw:WikiLink/Interwiki\" href=\"https://en.wikipedia.org/wiki/en:J.%20M.%20W.%20Turner\" title=\"w:en:J. M. W. Turner\" class=\"extiw\"><span title=\"English painter and draftsman (c.1775–1851)\">J. M. W. Turner</span></a></bdi>",
          "source": "commons-desc-page"
