filters:
  and:
    - 'file.folder == "Storylines/Adventures"'
    - 'type == "adventure"'
properties:
  file.name:
    displayName: Name
  status:
    displayName: Status
  act:
    displayName: Act
  patron:
    displayName: Patron
  objective:
    displayName: Objective
  related-factions:
    displayName: Factions
  related-locations:
    displayName: Locations
  related-npcs:
    displayName: NPCs
views:
  - type: table
    name: GM Adventures
    order:
      - file.name
      - status
      - act
      - patron
      - objective
      - related-factions
      - related-locations
      - related-npcs
